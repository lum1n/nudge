        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varsler"
          }
        }
      }
    },
    "Nudge makes a small server in your exe.dev account, billed to it, with an HTTPS address of its own." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nudge lager en liten server i exe.dev-kontoen din, fakturert til den, med en egen HTTPS-adresse."
          }
        }
      }
    },
    "Nudge recovery kit for %@" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nudge-gjenopprettingssett for %@"
          }
        }
      }
    },
    "Nudge tells you when an answer is ready or an action waits for your approval, while the app is closed." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nudge sier fra når et svar er klart eller en handling venter på godkjenningen din, mens appen er lukket."
          }
        }
      }
    },
    "Nudge writes out what you say on this device, so your voice never leaves it. It needs a speech model for that (%@), downloaded once. Settings has others." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nudge skriver ut det du sier på denne enheten, så stemmen din forlater den aldri. Den trenger en talemodell for det (%@), lastet ned én gang. Innstillinger har andre."
          }
        }
      }
    },
    "Nudges" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Påminnelser"
          }
        }
      }
    },
    "Off" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Av"
          }
        }
      }
    },
    "Off: this server makes no backups of its own. Setting a copy below turns them on, daily." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Av: denne serveren lager ingen egne sikkerhetskopier. Velger du en kopi nedenfor, slås de på, daglig."
          }
        }
      }
    },
    "OK" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OK"
          }
        }
      }
    },
    "On by default in" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På som standard i"
          }
        }
      }
