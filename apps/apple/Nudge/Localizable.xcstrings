    },
    "Downloading the speech model" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laster ned talemodellen"
          }
        }
      }
    },
    "Drag to select" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra for å velge"
          }
        }
      }
    },
    "Dragging scrolls." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Å dra blar."
          }
        }
      }
    },
    "Dragging selects and moves things." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Å dra velger og flytter ting."
          }
        }
      }
    },
    "E-mail" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-post"
          }
        }
      }
    },
    "Earlier messages summarized" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidligere meldinger oppsummert"
          }
        }
      }
    },
    "Endpoint" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endepunkt"
          }
        }
      }
    },
    "Every %lld hours, the last %lld kept, in %@." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver %1$lld. time, de siste %2$lld beholdes, i %3$@."
          }
        }
      }
    },
    "Every day, the last %lld kept, in %@." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver dag, de siste %1$lld beholdes, i %2$@."
          }
        }
      }
    },
    "Every room" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle rom"
          }
        }
      }
    },
    "Everyone" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle"
          }
        }
      }
    },
    "Everything on it goes for good, and nothing is kept: make a recovery kit and download a backup first if you need one. Type %@ to remove it." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alt på den forsvinner for godt, og ingenting beholdes: lag et gjenopprettingssett og last ned en sikkerhetskopi først hvis du trenger det. Skriv %@ for å fjerne den."
          }
        }
      }
    },
    "exe.dev asks for your email and sends you a link. Open it, then come back: the app is signed in once exe.dev has your key." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "exe.dev spør om e-posten din og sender deg en lenke. Åpne den, og kom så tilbake: appen er logget inn når exe.dev har nøkkelen din."
          }
        }
      }
    },
    "exe.dev token" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "exe.dev-token"
          }
        }
      }
    },
    "Extensions" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utvidelser"
          }
        }
      }
    },
    "Eyes" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Øyne"
          }
        }
      }
    },
    "Facts about you, shown in your own room. Shared, every room you're in sees them, and the assistant there too." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fakta om deg, vist i ditt eget rom. Når de er delt, ser alle rom du er i dem, og assistenten der også."
          }
        }
      }
    },
    "Fetch the region someone's phone says they are in, anywhere in the world." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hent regionen noens telefon sier at de er i, hvor som helst i verden."
          }
        }
      }
    },
    "Find by name" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finn etter navn"
          }
        }
      }
    },
    "First item" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Første punkt"
          }
        }
      }
    },
    "Folder address" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mappeadresse"
          }
        }
      }
    },
    "Folder in the bucket" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mappe i bøtta"
          }
        }
      }
    },
    "Follow people" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Følg personer"
          }
        }
      }
    },
    "For \"remind me when I get home\": the device tells home when you get to a place you have a reminder for." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For «minn meg på det når jeg kommer hjem»: enheten forteller hjemmet når du kommer til et sted du har en påminnelse for."
          }
        }
      }
    },
    "For every assistant here. Tried once before it is kept." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For alle assistentene her. Prøves én gang før den beholdes."
          }
        }
      }
    },
    "For filling in forms, writing mail and finding what is near you. Only you see them, and they stay at home: the model gets placeholders such as ⟦EMAIL1⟧, in your own room and private messages, and tools get the real values. Your location is sent while the app is open." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For å fylle ut skjemaer, skrive e-post og finne det som er i nærheten av deg. Bare du ser dem, og de blir hjemme: modellen får plassholdere som ⟦EMAIL1⟧, i ditt eget rom og i private meldinger, og verktøy får de ekte verdiene. Posisjonen din sendes mens appen er åpen."
          }
        }
      }
    },
    "Forget" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glem"
          }
        }
      }
    },
    "Forget for good" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glem for godt"
          }
        }
      }
    },
    "Full name" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fullt navn"
          }
        }
      }
    },
    "Get a key" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skaff en nøkkel"
          }
        }
      }
    },
    "Hide" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjul"
          }
        }
      }
    },
    "Hide a value…" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjul en verdi …"
          }
        }
      }
    },
    "Hold a network here" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold et nettverk her"
          }
        }
      }
    },
    "Holds the network as %@" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Holder nettverket som %@"
          }
        }
      }
    },
    "How the assistant's robot looks to everyone. Turn extensions on or off and change their settings, for every room. Invite someone from another assistant by their address." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvordan assistentens robot ser ut for alle. Slå utvidelser av eller på og endre innstillingene deres, for alle rom. Inviter noen fra en annen assistent med adressen deres."
          }
        }
      }
    },
    "In its address" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I adressen"
          }
        }
      }
    },
    "In its address: %@" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I adressen: %@"
          }
        }
      }
    },
    "In the network as %@" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I nettverket som %@"
          }
        }
      }
    },
    "In this room" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dette rommet"
          }
        }
      }
    },
    "Instructions" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instruksjoner"
          }
        }
      }
    },
    "Invites" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invitasjoner"
          }
        }
      }
    },
    "It gets federation, and you join it from home as the person you are there now: its rooms and history stay, and your other devices list it." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den får føderasjon, og du blir med i den hjemmefra som den personen du er der nå: rommene og historikken blir, og de andre enhetene dine viser den."
          }
        }
      }
    },
    "It goes for everyone in the room, and the assistant can't read it any more." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den forsvinner for alle i rommet, og assistenten kan ikke lese den lenger."
          }
        }
      }
    },
    "It no longer reaches your servers over Wired, and can't join again with its key. A new server can then use the name." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den når ikke lenger serverne dine over Wired, og kan ikke bli med igjen med nøkkelen sin. En ny server kan da bruke navnet."
          }
        }
      }
    },
    "Its address will be https://%@.exe.xyz" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adressen blir https://%@.exe.xyz"
          }
        }
      }
    },
    "Its name" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navnet"
          }
        }
      }
    },
    "Its rooms show beside your home's, and you are its admin and an owner of this server." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rommene vises ved siden av hjemmets, og du er administrator for den og en eier av denne serveren."
          }
        }
      }
    },
    "Its rooms, history and memory go. The server keeps a backup for 30 days. Type %@ to delete it." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rommene, historikken og minnet forsvinner. Serveren beholder en sikkerhetskopi i 30 dager. Skriv %@ for å slette den."
          }
        }
      }
    },
    "Its setup code" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppsettkoden"
          }
        }
      }
    },
    "Join" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bli med"
          }
        }
      }
    },
    "Join %@ on Nudge" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bli med i %@ på Nudge"
          }
        }
      }
    },
    "Join %@ to your cluster?" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legge til %@ i klyngen din?"
          }
        }
      }
    },
    "Join %@?" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bli med i %@?"
          }
        }
      }
    },
    "Join %@'s network" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bli med i nettverket til %@"
          }
        }
      }
    },
    "Join %@'s Wired network" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bli med i Wired-nettverket til %@"
          }
        }
      }
    },
    "Join it from home" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bli med i den hjemmefra"
          }
        }
      }
    },
    "Join my cluster" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bli med i klyngen min"
          }
        }
      }
    },
    "Joined from home" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fra hjemmet"
          }
        }
      }
    },
    "Joining…" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blir med …"
          }
        }
      }
    },
    "Keep" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behold"
          }
        }
      }
    },
    "Keep the recovery kit" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta vare på gjenopprettingssettet"
          }
        }
      }
    },
    "Kept encrypted on the server, never shown again." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagres kryptert på serveren, vises aldri igjen."
          }
        }
      }
    },
    "Kept; type to change it" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beholdt; skriv for å endre den"
          }
        }
      }
    },
    "Key" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nøkkel"
          }
        }
      }
    },
    "Language" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Språk"
          }
        }
      }
    },
    "Languages you speak" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Språk du snakker"
          }
        }
      }
    },
    "Last uploaded %@." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
