    "Turn off Wired here?" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå av Wired her?"
          }
        }
      }
    },
    "Turn on federation at home" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå på føderasjon hjemme"
          }
        }
      }
    },
    "Turn on notifications" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå på varsler"
          }
        }
      }
    },
    "Turn on Share where I am in your profile to change it." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå på Del hvor jeg er i profilen din for å endre det."
          }
        }
      }
    },
    "Turn on the connectors extension for this room under Room." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå på koblingsutvidelsen for dette rommet under Rom."
          }
        }
      }
    },
    "Turn on the documents extension for this room under Room." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå på dokumentutvidelsen for dette rommet under Rom."
          }
        }
      }
    },
    "Turn on the lists extension for this room under Room." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå på listeutvidelsen for dette rommet under Rom."
          }
        }
      }
    },
    "Turn on the mcp extension for this room under Room." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå på mcp-utvidelsen for dette rommet under Rom."
          }
        }
      }
    },
    "Turning it on…" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slår den på …"
          }
        }
      }
    },
    "Type into the desktop" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv på skrivebordet"
          }
        }
      }
    },
    "Type into the page" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv på siden"
          }
        }
      }
    },
    "Until %@" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Til %@"
          }
        }
      }
    },
    "Update automatically" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppdater automatisk"
          }
        }
      }
    },
    "Upload" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Last opp"
          }
        }
      }
    },
    "Uploading %@…" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laster opp %@ …"
          }
        }
      }
    },
    "Use as your home's address" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk som hjemmets adresse"
          }
        }
      }
    },
    "Use http://nudge.%@.wired as your home's address?" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruke http://nudge.%@.wired som hjemmets adresse?"
          }
        }
      }
    },
    "Use it" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk den"
          }
        }
      }
    },
    "Use it for" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk den til"
          }
        }
      }
    },
    "Use this device's: %@" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk denne enhetens: %@"
          }
        }
      }
    },
    "User name" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brukernavn"
          }
        }
      }
    },
    "Waiting for the connection" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venter på tilkoblingen"
          }
        }
      }
    },
    "Waiting for the page…" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venter på siden …"
          }
        }
      }
    },
    "Waiting for the screen…" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venter på skjermen …"
          }
        }
      }
    },
    "Waiting to join" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venter på å bli med"
          }
        }
      }
    },
    "Watching %lld places for your reminders." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overvåker %lld steder for påminnelsene dine."
          }
        }
      }
    },
    "Wears" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Har på seg"
          }
        }
      }
    },
    "What it calls itself. You can change it later." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det den kaller seg selv. Du kan endre det senere."
          }
        }
      }
    },
    "What the assistant can do beyond talking. Saving installs them again right away and writes them to the server's nudge.json; if one fails to start, nothing changes. Each room can still turn them on or off for itself." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det assistenten kan gjøre utover å snakke. Når du lagrer, installeres de på nytt med en gang og skrives til serverens nudge.json; hvis én ikke starter, endres ingenting. Hvert rom kan fortsatt slå dem av eller på for seg selv."
          }
        }
      }
    },
    "What the assistant knows in this room." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det assistenten vet i dette rommet."
          }
        }
      }
    },
    "What the model saw" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det modellen så"
          }
        }
      }
    },
    "What you say is written out on this device: your voice never leaves it. Nudge hides personal details from the assistant's model in the text, as in what you type." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det du sier, skrives ut på denne enheten: stemmen din forlater den aldri. Nudge skjuler personopplysninger for assistentens modell i teksten, som i det du skriver."
          }
        }
      }
    },
    "Where is the server?" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor er serveren?"
          }
        }
      }
    },
    "Where your Nudge runs." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Nudge-en din kjører."
          }
        }
      }
    },
    "Who is it for?" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvem er den for?"
          }
        }
      }
    },
    "Wired" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wired"
          }
        }
      }
    },
    "With it and a backup, everything on this server can be brought back. Keep it away from the server, and the passphrase in your password manager." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med det og en sikkerhetskopi kan alt på denne serveren hentes tilbake. Oppbevar det et annet sted enn serveren, og passfrasen i passordbehandleren din."
          }
        }
      }
    },
    "With your own API key" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med din egen API-nøkkel"
          }
        }
      }
    },
    "Working…" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jobber …"
          }
        }
      }
    },
    "You have rooms on these. If one is yours, manage it here: your home vouches for you." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har rom på disse. Hvis en av dem er din, kan du administrere den her: hjemmet ditt går god for deg."
          }
        }
      }
    },
    "You joined it from home: its rooms are beside your own." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du ble med i den hjemmefra: rommene ligger ved siden av dine egne."
          }
        }
      }
    },
    "You left this room" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du forlot dette rommet"
          }
        }
      }
    },
    "You will be %@'s first person, its admin, and this server's owner." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du blir den første personen hos %@, administratoren og eieren av denne serveren."
          }
        }
      }
    },
    "You'll need a new pairing code from it to sign in again." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du trenger en ny koblingskode fra den for å logge inn igjen."
          }
        }
      }
    },
    "Your address" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adressen din"
          }
        }
      }
    },
    "Your assistant on Nudge" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assistenten din på Nudge"
          }
        }
      }
    },
    "Your devices stop managing it. You stay its owner, and nothing on the server changes." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enhetene dine slutter å administrere den. Du forblir eieren, og ingenting på serveren endres."
          }
        }
      }
    },
    "Your email, or what exe.dev asks" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-posten din, eller det exe.dev spør om"
          }
        }
      }
    },
    "Your home first" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hjemmet ditt først"
          }
        }
      }
    },
    "Your home stops sending it your profile and memory, and this device signs out of it. You stay a member there." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hjemmet ditt slutter å sende den profilen og minnet ditt, og denne enheten logger ut av den. Du forblir medlem der."
          }
        }
      }
    },
    "Your limit" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grensen din"
          }
        }
      }
    },
    "Your messages" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldingene dine"
          }
        }
      }
    },
    "Your name" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navnet ditt"
          }
        }
      }
    },
    "Your other servers then reach your home over Wired. Your home's address is who it is to other assistants: the ones you joined from home have to be joined again." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De andre serverne dine når da hjemmet ditt over Wired. Hjemmets adresse er hvem det er for andre assistenter: de du ble med i hjemmefra, må du bli med i på nytt."
          }
        }
      }
    },
    "Your servers reach each other over Wired, encrypted, with no port open at home: home holds the network, and servers with a public address join it." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serverne dine når hverandre over Wired, kryptert, uten noen åpen port hjemme: hjemmet holder nettverket, og servere med offentlig adresse blir med i det."
          }
        }
      }
    },
    "Your servers stop reaching each other through this network." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serverne dine slutter å nå hverandre gjennom dette nettverket."
          }
        }
      }
    },
    "Yours" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine"
          }
        }
      }
    },
    "Yours: their assistants, model keys and updates." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine: assistentene deres, modellnøkler og oppdateringer."
          }
        }
      }
    },
    "z" : {

    }
  },
  "version" : "1.0"
}