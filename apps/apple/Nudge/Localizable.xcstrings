        }
      }
    },
    "Or join one: hold a network on your home server first, then come back here." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eller bli med i et: hold et nettverk på hjemmeserveren din først, og kom så tilbake hit."
