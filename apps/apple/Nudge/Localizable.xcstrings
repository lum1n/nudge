    },
    "Trying again (%lld): %@" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prøver igjen (%1$lld): %2$@"
          }
        }
      }
    },
    "Turn off" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå av"
          }
        }
