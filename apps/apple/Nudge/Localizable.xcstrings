    "MCP servers" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP-servere"
          }
        }
      }
    },
    "MCP servers this room's assistant can use. Ask it in the chat to add one. Keys and sign-ins go here only: the assistant never sees them." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP-servere assistenten i dette rommet kan bruke. Be den i chatten om å legge til en. Nøkler og innlogginger legges bare inn her: assistenten ser dem aldri."
          }
        }
      }
    },
    "Me: I join it from my home, and keep one sign-in" : {
      "localizations" : {
