      }
    },
    "At most %lld GB on disk (%@ now)" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Høyst %1$lld GB på disk (%2$@ nå)"
          }
        }
      }
    },
    "Back" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilbake"
          }
        }
      }
    },
    "Back to the app icon's" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilbake til appikonets"
          }
        }
      }
    },
    "Back up every night, keeping two weeks, beside the data" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta sikkerhetskopi hver natt, og behold to uker, ved siden av dataene"
          }
        }
      }
    },
    "Back up now" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta sikkerhetskopi nå"
          }
        }
      }
    },
    "Backing up…" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tar sikkerhetskopi …"
          }
        }
      }
    },
    "Backups" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sikkerhetskopier"
          }
        }
      }
    },
    "Backups stay on the server only. What was copied there is left there." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sikkerhetskopiene blir bare på serveren. Det som er kopiert dit, blir liggende der."
          }
        }
      }
    },
    "Browser" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
