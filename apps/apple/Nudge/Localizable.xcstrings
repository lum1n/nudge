      }
    },
    "%@ is ready" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ er klar"
          }
        }
      }
    },
    "%@ is ready for %@" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ er klar for %2$@"
          }
        }
      }
    },
    "%@ is using the browser; you are watching." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bruker nettleseren; du ser på."
          }
        }
      }
    },
    "%@ is using the desktop; you are watching." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bruker skrivebordet; du ser på."
          }
        }
      }
    },
    "%@ key" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nøkkel for %@"
          }
        }
      }
    },
    "%@ on %@" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ på %2$@"
          }
        }
      }
    },
    "%@ tells it who you are: your name, picture, time zone and language. Its rooms show up beside your own." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ forteller den hvem du er: navnet ditt, bildet, tidssonen og språket. Rommene dens vises ved siden av dine egne."
          }
        }
      }
    },
    "%@, %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$@"
          }
        }
      }
    },
    "%u to approve" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%u å godkjenne"
          }
        }
      }
    },
    "1. Sign in to exe.dev" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Logg inn på exe.dev"
          }
        }
      }
    },
    "2. Name the server" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Gi serveren et navn"
          }
        }
      }
    },
    "A server on exe.dev" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En server på exe.dev"
          }
        }
      }
    },
    "A server that isn't set up yet prints its address and a setup code when it starts." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En server som ikke er satt opp ennå, skriver ut adressen sin og en oppsettkode når den starter."
          }
        }
      }
    },
    "A small server in your exe.dev account, with an HTTPS address." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En liten server i exe.dev-kontoen din, med en HTTPS-adresse."
          }
        }
      }
    },
    "A WebDAV folder" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En WebDAV-mappe"
          }
        }
      }
    },
    "Access key id" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilgangsnøkkel-ID"
          }
        }
      }
    },
    "Account" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konto"
          }
        }
      }
    },
    "Actions waiting for approval" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handlinger som venter på godkjenning"
          }
        }
      }
    },
    "Activity" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivitet"
          }
        }
      }
    },
    "Add" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til"
          }
        }
      }
    },
    "Add a language" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til et språk"
          }
        }
      }
    },
    "Add a region" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til en region"
          }
        }
      }
    },
    "Add to %@…" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til i %@ …"
          }
        }
      }
    },
    "Address" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adresse"
          }
        }
      }
    },
    "Addresses, places and routes for reminders when someone gets somewhere, from OpenStreetMap. The server downloads the map of each region and keeps it, so where people go stays here." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adresser, steder og ruter for påminnelser når noen kommer et sted, fra OpenStreetMap. Serveren laster ned kartet over hver region og beholder det, så hvor folk drar, blir her."
          }
        }
      }
    },
    "Always use first" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk alltid først"
          }
        }
      }
    },
    "An address, a name or a number: the others and the assistant see it as hidden, in every room. Forgotten, everyone sees only that it was hidden." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En adresse, et navn eller et nummer: de andre og assistenten ser det som skjult, i alle rom. Når det er glemt, ser alle bare at det var skjult."
          }
        }
      }
    },
    "An admin of another assistant invites you by your address; the invite opens here. What only you see stays home." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En administrator for en annen assistent inviterer deg med adressen din; invitasjonen åpnes her. Det bare du ser, blir hjemme."
          }
        }
      }
    },
    "An app password, if the service has them" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et app-passord, hvis tjenesten har det"
          }
        }
      }
    },
    "An S3 bucket" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En S3-bøtte"
          }
        }
      }
    },
    "And you?" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Og du?"
          }
        }
      }
    },
    "Answering" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svarer"
          }
        }
      }
    },
    "Answers and nudges" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svar og påminnelser"
          }
        }
      }
    },
    "API key (%@ %@)" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API-nøkkel (%1$@ %2$@)"
          }
        }
      }
    },
    "APIs this room's assistant can call. Ask it in the chat to add one, and say what for. Turn on Always use first to have it try one before anything else for those tasks. API keys go here only: the assistant never sees them." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API-er assistenten i dette rommet kan kalle. Be den i chatten om å legge til et, og si hva det skal brukes til. Slå på Bruk alltid først for at den skal prøve det før noe annet for de oppgavene. API-nøkler legges bare inn her: assistenten ser dem aldri."
          }
        }
      }
    },
    "Approval" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Godkjenning"
          }
        }
      }
    },
    "Approve" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Godkjenn"
          }
        }
      }
    },
    "Ask an admin of the assistant for one, or for its QR code: they make it under People and devices in their settings, in the Android app or on the web. It works once, for ten minutes. A token (`nudge_…`) works here too." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Be en administrator for assistenten om en, eller om QR-koden: de lager den under Personer og enheter i innstillingene sine, i Android-appen eller på nettet. Den virker én gang, i ti minutter. Et token (`nudge_…`) virker her også."
          }
        }
      }
    },
    "Ask before calls that change something" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spør før kall som endrer noe"
          }
        }
      }
    },
    "Ask before every call" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spør før hvert kall"
          }
        }
      }
    },
    "Ask the assistant to save a place or remind you when you get somewhere. The model only sees places as placeholders such as ⟦PLACE:home⟧." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Be assistenten lagre et sted eller minne deg på noe når du kommer et sted. Modellen ser bare steder som plassholdere, for eksempel ⟦PLACE:home⟧."
          }
        }
      }
    },
    "Assistant" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assistent"
          }
        }
      }
    },
    "Assistants" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assistenter"
          }
        }
      }
    },
    "Assistants you joined get this too." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assistenter du har blitt med i, får dette også."
          }
        }
      }
    },
    "At most %@ GB on disk (%@ now)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "At most %1$@ GB on disk (%2$@ now)"
          }
