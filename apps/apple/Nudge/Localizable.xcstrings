    "Bus and train departures" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buss- og togavganger"
          }
        }
      }
    },
    "Calls that only read, though not GET: one METHOD /path per line, such as POST /graphql. They run without asking." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kall som bare leser, selv om de ikke er GET: én METODE /sti per linje, for eksempel POST /graphql. De kjøres uten å spørre."
          }
        }
      }
    },
