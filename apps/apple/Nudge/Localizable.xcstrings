            "value" : "Bare du ser"
          }
        }
      }
    },
    "Open the room's browser to log in" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åpne rommets nettleser for å logge inn"
          }
        }
      }
    },
    "Optional: us-east-1 unless the endpoint says" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valgfritt: us-east-1 med mindre endepunktet sier noe annet"
