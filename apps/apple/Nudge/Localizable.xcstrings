        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forlate %@?"
          }
        }
      }
    },
    "Let the assistant know where I am here" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La assistenten vite hvor jeg er her"
          }
        }
      }
    },
    "Lists" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lister"
          }
        }
      }
    },
    "Load earlier" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Last inn tidligere"
          }
        }
      }
    },
    "Local network" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokalt nettverk"
          }
        }
      }
    },
    "Location" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posisjon"
          }
        }
      }
    },
    "Lowercase letters, digits and dashes, such as box." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Små bokstaver, sifre og bindestreker, for eksempel box."
          }
        }
      }
    },
    "Made %@ and uploaded it." : {
      "localizations" : {
