{
  "name": "@nudge/ext-browser",
  "version": "0.0.1",
  "private": true,
  "description": "Text-only browser use for Nudge: a headed, persistent browser driven through compacted accessibility snapshots",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@nudge/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "eval": "node --conditions=@nudge/source eval/run.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.2.0",
    "@nudge/core": "workspace:*",
    "patchright": "1.63.0",
    "typebox": "1.3.27"
  }
}
