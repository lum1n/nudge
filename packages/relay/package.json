{
  "name": "@nudge/relay",
  "version": "0.1.0",
  "private": true,
  "description": "The push relay: Nudge hosts push to the published apps through it, sealed for each device",
  "bin": {
    "nudge-relay": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@nudge/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@nudge/ext-push": "workspace:*",
    "hono": "4.13.13",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@nudge/core": "workspace:*",
    "@nudge/server": "workspace:*"
  }
}
