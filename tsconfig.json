{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "customConditions": ["@nudge/source"]
  },
  "include": [
    "packages/*/src",
    "packages/*/test",
    "extensions/*/src",
    "extensions/*/test",
    "extensions/*/eval",
    "vitest.config.ts"
  ]
}
