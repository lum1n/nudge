{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "customConditions": ["@nudge/source"]
  },
  "include": [
    "packages/*/src",
    "packages/*/test",
    "packages/*/scripts",
    "extensions/*/src",
    "extensions/*/test",
    "extensions/*/eval",
    "vitest.config.ts"
  ],
  // Runs on workerd, with its own types: `pnpm -C packages/cloudflare typecheck`.
  "exclude": ["packages/cloudflare"]
}
